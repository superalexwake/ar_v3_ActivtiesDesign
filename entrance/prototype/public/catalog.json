	"activities": {
		"vip": {
			"note": "Type 29、30 共用这块面板；等级与经验同时驱动我的页 VIP 信息条和 VIP 页等级卡。",
			"params": [
				{ "name": "level", "label": "当前等级", "type": "number", "default": 3, "min": 0, "max": 10, "drives": "GetVipUsers.vipLevel；GetVipUserLevelDetail[].status/upgradeStatus（≤ 当前为已达成）；GetListVipUserRewards 可领等级" },
				{ "name": "exp", "label": "经验值", "type": "number", "default": 1200, "min": 0, "max": 99999, "drives": "GetVipUsers.exp、GetVipUserLevelDetail[].currentExp" },
				{ "name": "upgradeReward", "label": "升级礼包", "type": "select", "default": "claimable", "options": [{ "value": "claimable", "label": "可领取" }, { "value": "claimed", "label": "已领取" }], "drives": "当前等级 rewardType 1 的 status（1 可领、2 已领）" },
				{ "name": "monthlyReward", "label": "每月奖励", "type": "select", "default": "claimable", "options": [{ "value": "claimable", "label": "可领取" }, { "value": "claimed", "label": "已领取" }], "drives": "当前等级 rewardType 2 的 status" },
				{ "name": "settleDays", "label": "距结算天数", "type": "number", "default": 9, "min": 0, "max": 31, "unit": "天", "drives": "GetVipUsers.settlementDate（天数，非时间戳）" }
			],
			"presets": [
				{ "label": "新用户 VIP0", "values": { "level": 0, "exp": 0 }, "note": "我的福利区隐藏，所有等级卡为未解锁" },
				{ "label": "升级礼包可领（默认）", "values": {}, "note": "VIP3 卡为当前等级，升级礼包、每月奖励两个“领取”按钮可点" },
