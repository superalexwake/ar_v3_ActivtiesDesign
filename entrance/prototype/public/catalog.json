				{ "label": "全部已领", "values": { "upgradeReward": "claimed", "monthlyReward": "claimed" }, "note": "两个按钮置灰“已领取”" },
				{ "label": "满级 VIP10", "values": { "level": 10, "exp": 99999 }, "note": "全部等级卡已达成，当前卡显示保级进度" }
